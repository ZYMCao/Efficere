		"build": "vp build",
		"preview": "vp preview",
		"lint": "vp lint"
	},
	"dependencies": {
		"@effect/platform-node": "~4",
		"@solidjs/vite-plugin": "^3.0.0-next.0",
		"@solidjs/web": "^2.0.0-rc.21",
		"@tailwindcss/vite": "~4",
		"effect": "~4",
		"solid-js": "^2.0.0-rc.0",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
	},
	"devDependencies": {
		"@ast-grep/cli": "~0",
		"@effect/tsgo": "~0",
		"@types/node": "~24",
		"tailwindcss": "~4",
		"typescript": "~7",
		"vite-plus": "1.6.0"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
	},

{
	"name": "react-example",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare": "vp config --no-agent && mkdir -p .vite-hooks && echo 'vp staged --fail-on-changes' > .vite-hooks/pre-commit && effect-tsgo patch --typescript --oxlint",
